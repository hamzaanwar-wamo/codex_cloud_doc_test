digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.2",ranksep="0.35"];
node [shape=box,style="rounded,filled",fillcolor="#EAF2F8",color="#397399",fontname="DejaVu Sans",fontsize=11];
edge [color="#526574",fontname="DejaVu Sans",fontsize=9];
i [label="Authenticated identity"];
p [label="Trusted scope / policy service"];
r [label="Search / graph / SQL / parent fetch"];
c [label="Cache + source links"];
e [label="Authorized evidence only"];
o [label="Model + constrained tools\nNo model-granted capabilities"];
a [label="Output + access-controlled audit"];
i -> p;
p -> r;
p -> c;
r -> e;
c -> e;
e -> o;
o -> a;
}