digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.2",ranksep="0.35"];
node [shape=box,style="rounded,filled",fillcolor="#EAF2F8",color="#397399",fontname="DejaVu Sans",fontsize=11];
edge [color="#526574",fontname="DejaVu Sans",fontsize=9];
s [label="Source revision + tenant"];
j [label="Idempotent job\nSave original / parse / chunk"];
i [label="Write new lexical + vector version"];
v [label="Validate completeness + access"];
p [label="Publish manifest"];
r [label="Retry / reconcile / DLQ"];
s -> j;
j -> i;
i -> v;
v -> p [label="complete"];
i -> r [label="failure"];
r -> j [label="safe retry"];
}