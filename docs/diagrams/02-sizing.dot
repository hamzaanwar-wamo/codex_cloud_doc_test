digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.2",ranksep="0.35"];
node [shape=box,style="rounded,filled",fillcolor="#EAF2F8",color="#397399",fontname="DejaVu Sans",fontsize=11];
edge [color="#526574",fontname="DejaVu Sans",fontsize=9];
w [label="Workload assumptions\nQueries + files + update rate"];
q [label="Peak QPS x duration\nIn-flight requests"];
s [label="Chunks x dimensions x bytes\nRaw vector storage"];
b [label="Measure bottlenecks\nOCR / index / model quotas"];
c [label="Provision + load test\nHeadroom + recovery capacity"];
w -> q;
w -> s;
q -> b;
s -> b;
b -> c;
}