digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.2",ranksep="0.35"];
node [shape=box,style="rounded,filled",fillcolor="#EAF2F8",color="#397399",fontname="DejaVu Sans",fontsize=11];
edge [color="#526574",fontname="DejaVu Sans",fontsize=9];
s [label="Sources -> chunks + spans"];
e [label="Extract + resolve entities / assertions"];
g [label="Versioned graph + optional summaries"];
q [label="Scoped entity / relation query"];
p [label="Bounded permitted paths"];
f [label="Fetch original evidence for each edge"];
a [label="Verify joins + dates -> cited answer"];
s -> e;
e -> g;
g -> q;
q -> p;
p -> f;
f -> a;
}