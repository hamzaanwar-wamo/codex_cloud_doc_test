digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.2",ranksep="0.35"];
node [shape=box,style="rounded,filled",fillcolor="#EAF2F8",color="#397399",fontname="DejaVu Sans",fontsize=11];
edge [color="#526574",fontname="DejaVu Sans",fontsize=9];
r [label="Request / ingestion trace ID"];
s [label="Safe spans: IDs + versions + ranks"];
m [label="Metrics: latency / quality / freshness / cost"];
a [label="Audit: authorized access / actions"];
d [label="Detect + investigate + isolate"];
f [label="Restore verified path / regression"];
r -> s;
s -> m;
s -> a;
m -> d;
a -> d;
d -> f;
}