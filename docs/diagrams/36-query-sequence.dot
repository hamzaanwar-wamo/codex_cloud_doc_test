digraph G {
graph [rankdir=TB,bgcolor="white",pad="0.2",ranksep="0.35"];
node [shape=box,style="rounded,filled",fillcolor="#EAF2F8",color="#397399",fontname="DejaVu Sans",fontsize=11];
edge [color="#526574",fontname="DejaVu Sans",fontsize=9];
u [label="1 USER -> API\nquestion + authenticated session"];
a [label="2 API -> POLICY\nresolve current access"];
s [label="3 ORCHESTRATOR -> SEARCHES\nparallel scoped retrieval"];
r [label="4 SEARCHES -> ORCHESTRATOR\ncandidate IDs / ranks / versions"];
e [label="5 ORCHESTRATOR -> SOURCES\nfetch authorized applicable evidence"];
m [label="6 ORCHESTRATOR -> MODEL\nquestion + bounded source blocks"];
v [label="7 MODEL -> VERIFIER\ndraft + citation IDs"];
o [label="8 API -> USER\nverified answer or gap"];
u -> a;
a -> s;
s -> r;
r -> e;
e -> m;
m -> v;
v -> o;
}